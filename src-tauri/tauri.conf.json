{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByShoot",
  "version": "0.1.8",
  "identifier": "com.bycoda.byshoot",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "ByShoot", "width": 620, "height": 460, "minWidth": 560, "minHeight": 420, "visible": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "category": "Utility", "shortDescription": "Fast screen capture and annotation", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
